# Copy this file to .env.local and change the value.
# Long random string used to sign login sessions, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Optional: folder holding data.json and messages.json (defaults to the project root)
# DATA_DIR=/var/lib/bhrm
